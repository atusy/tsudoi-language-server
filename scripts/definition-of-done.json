[
  {
    "name": "Unit tests pass",
    "run": "bun test packages scripts/src"
  },
  {
    "name": "Integration tests pass",
    "run": "bun test tests/integration"
  },
  {
    "name": "E2E tests pass",
    "run": "bun test tests/e2e"
  },
  {
    "name": "Lint passes",
    "run": "oxlint --format unix --deny-warnings --report-unused-disable-directives-severity error"
  },
  {
    "name": "Format check passes",
    "run": "oxfmt --check ."
  },
  {
    "name": "Type check passes",
    "run": "tsc --noEmit"
  },
  {
    "name": "Workspace members type-check under their own configs",
    "run": "bun run scripts/typecheck-workspaces.ts"
  }
]
